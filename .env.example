# 复制为 .env 后仅用于本地调试；线上请在 EdgeOne Makers 控制台配置环境变量。
# 以下变量由 Makers 平台自动注入，通常无需手动填写。
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
# 切换模型只改这个变量，业务代码不需要修改。
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# 可选：腾讯元宝搜索密钥。当前版本联网搜索使用 Makers 内置 web_search，
# 该变量会被读取并保留，便于后续切换为直连搜索时使用。
WSA_API_KEY=
